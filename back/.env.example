MONGO_URI=mongodb://127.0.0.1:27017/kuepa_test
# Opcional: adaptador de Socket.IO para varias instancias del back
REDIS_URL=
PORT=7001
PUBLIC_URL=http://localhost:7001
JWT_SECRET=
SEED_ADMIN_PASSWORD=
# Email del usuario de prueba; con él entra por Google o Facebook
SEED_ADMIN_EMAIL=
# Cloudflare Turnstile (captcha). Valor de prueba oficial que siempre pasa; en producción usa tu secreto real
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# true si el back está detrás de un proxy (para leer la IP real en el límite de peticiones)
TRUST_PROXY=false
# Logto (inicio de sesión social); no son secretos
LOGTO_ENDPOINT=
LOGTO_APP_ID=
