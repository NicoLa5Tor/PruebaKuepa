# Copia este archivo a Dev/.env y define JWT_SECRET y SEED_ADMIN_PASSWORD.
# El captcha ya trae las llaves de prueba de Cloudflare (siempre pasan).
MONGO_URI=mongodb://127.0.0.1:27017/kuepa_test
REDIS_URL=
PORT=7001
PUBLIC_URL=http://localhost:7001
JWT_SECRET=
SEED_ADMIN_PASSWORD=
# Email del usuario de prueba; con él entra por Google o Facebook
SEED_ADMIN_EMAIL=
LOGTO_ENDPOINT=https://logto.arisma.com.co
LOGTO_APP_ID=wpqq5ute5og9jfags2mom
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TRUST_PROXY=false

# Las consume el build del front
VITE_API_URL=http://localhost:7001
VITE_PUBLIC_URL=http://localhost:7001
VITE_LOGTO_ENDPOINT=https://logto.arisma.com.co
VITE_LOGTO_APP_ID=wpqq5ute5og9jfags2mom
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
